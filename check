-- Parameter Manipulation Testing
local function testParameterManipulation(remotePath, originalArgs)
    if not CONFIG.TEST_PARAMETER_MANIPULATION then return end
    
    local remote = REMOTE_REGISTRY[remotePath]
    if not remote then
        log("Remote not found: " .. remotePath, "ERROR")
        return
    end
    
    log(string.format("Testing parameter manipulation on: %s", remotePath), "INFO")
    
    -- Test 1: Type confusion
    if #originalArgs > 0 then
        local modifiedArgs = {}
        for i, arg in ipairs(originalArgs) do
            if type(arg) == "number" then
                table.insert(modifiedArgs, tostring(arg)) -- Number to string
            elseif type(arg) == "string" then
                table.insert(modifiedArgs, tonumber(arg) or 0) -- String to number
            else
                table.insert(modifiedArgs, arg)
            end
        end
        
        log("Test 1: Type confusion - sending modified types", "INFO")
        -- Note: Actually firing would require knowing if it's Event or Function
        -- This is a template for manual testing
    end
    
    -- Test 2: Extreme values
    if #originalArgs > 0 then
        local modifiedArgs = {}
        for i, arg in ipairs(originalArgs) do
            if type(arg) == "number" then
                table.insert(modifiedArgs, 999999) -- Extreme value
            else
                table.insert(modifiedArgs, arg)
            end
        end
        
        log("Test 2: Extreme values - sending overflow values", "INFO")
    end
    
    -- Test 3: Missing arguments
    if #originalArgs > 1 then
        local modifiedArgs = {originalArgs[1]} -- Only first arg
        log("Test 3: Missing arguments - sending incomplete data", "INFO")
    end
    
    -- Test 4: Extra arguments
    local modifiedArgs = {}
    for _, arg in ipairs(originalArgs) do
        table.insert(modifiedArgs, arg)
    end
    table.insert(modifiedArgs, "extra_arg")
    table.insert(modifiedArgs, 12345)
    log("Test 4: Extra arguments - sending additional data", "INFO")
end

-- Vulnerability Scanner
local function scanForVulnerabilities()
    log("Starting vulnerability scan...", "INFO")
    
    -- Pattern 1: Remotes with "admin", "mod", "command" in name
    for path, remote in pairs(REMOTE_REGISTRY) do
        local lowerPath = path:lower()
        if lowerPath:find("admin") or lowerPath:find("mod") or lowerPath:find("command") then
            log(string.format("[PRIORITY] Admin-related remote: %s", path), "WARN")
            table.insert(VULNERABILITY_CANDIDATES, {
                remote = path,
                reason = "Admin-related remote name pattern",
                priority = "HIGH"
            })
        end
    end
    
    -- Pattern 2: Remotes that accept tables (client-trusted data)
    for _, entry in ipairs(TRAFFIC_LOG) do
        if entry.analysis.suspicious then
            local alreadyLogged = false
            for _, vuln in ipairs(VULNERABILITY_CANDIDATES) do
                if vuln.remote == entry.remote then
                    alreadyLogged = true
                    break
                end
            end
            
            if not alreadyLogged then
                table.insert(VULNERABILITY_CANDIDATES, {
                    remote = entry.remote,
                    reason = "Suspicious argument pattern in traffic",
                    details = entry.analysis.details,
                    priority = "MEDIUM"
                })
            end
        end
    end
    
    -- Pattern 3: High-frequency remotes (potential race conditions)
    local remoteCounts = {}
    for _, entry in ipairs(TRAFFIC_LOG) do
        remoteCounts[entry.remote] = (remoteCounts[entry.remote] or 0) + 1
    end
    
    for path, count in pairs(remoteCounts) do
        if count > 100 then -- Arbitrary threshold
            log(string.format("[NOTE] High-frequency remote: %s (%d calls)", path, count), "INFO")
        end
    end
    
    log(string.format("Scan complete. Found %d vulnerability candidates.", #VULNERABILITY_CANDIDATES), "INFO")
end

-- Report Generator
local function generateReport()
    log("Generating vulnerability report...", "INFO")
    
    print("\n=== VULNERABILITY ANALYSIS REPORT ===")
    print(string.format("Total Remotes Found: %d", #REMOTE_REGISTRY))
    print(string.format("Traffic Entries Logged: %d", #TRAFFIC_LOG))
    print(string.format("Vulnerability Candidates: %d", #VULNERABILITY_CANDIDATES))
    
    print("\n--- HIGH PRIORITY ---")
    for _, vuln in ipairs(VULNERABILITY_CANDIDATES) do
        if vuln.priority == "HIGH" then
            print(string.format("[%s] %s", vuln.priority or "MEDIUM", vuln.remote))
            print("  Reason: " .. vuln.reason)
        end
    end
    
    print("\n--- MEDIUM PRIORITY ---")
    for _, vuln in ipairs(VULNERABILITY_CANDIDATES) do
        if vuln.priority == "MEDIUM" or not vuln.priority then
            print(string.format("[%s] %s", vuln.priority or "MEDIUM", vuln.remote))
            print("  Reason: " .. vuln.reason)
            if vuln.details then
                for _, detail in ipairs(vuln.details) do
                    print(string.format("  - Arg %d (%s): %s", detail.index, detail.type, detail.note))
                end
            end
        end
    end
    
    print("\n--- REMOTE STATISTICS ---")
    for path, remote in pairs(REMOTE_REGISTRY) do
        if remote.callCount > 0 then
            print(string.format("%s: %d calls | Suspicious: %s", path, remote.callCount, tostring(remote.suspicious)))
        end
    end
    
    print("\n=== END REPORT ===\n")
end

